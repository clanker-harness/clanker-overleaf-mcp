{
  "name": "clanker-overleaf-mcp",
  "version": "0.2.0",
  "description": "Overleaf bridge (SDK + CLI + MCP server) for the clanker stack — list/read/edit/compile Overleaf projects over the live collaboration channel. Vendored from claudeleaf so the clanker org owns the source.",
  "type": "module",
  "license": "MIT",
  "author": "Louis Jannett",
  "contributors": [
    "clanker-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clanker-harness/clanker-overleaf-mcp.git"
  },
  "keywords": [
    "overleaf",
    "latex",
    "mcp",
    "clanker",
    "automation",
    "sharejs",
    "collaboration"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "clanker-overleaf": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "clanker-overleaf": "tsx src/cli.ts",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.48.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
